using Gtk 4.0;

template $Gjs_OverlayWrapper: Overlay {
  [overlay]
  Revealer revealer {
    halign: bind revealer.child as <Widget>.halign;
    valign: bind revealer.child as <Widget>.valign;
    margin-bottom: 12;
    margin-top: 12;
    margin-start: 12;
    margin-end: 12;
    reveal-child: true;
    transition-type: crossfade;
  }
}
