using Gtk 4.0;
using Adw 1;

template $Gjs_MainWindow: Adw.ApplicationWindow {
  content: Adw.ToolbarView toolbar_view {
    top-bar-style: raised_border;

    [top]
    $Gjs_ShyBin {
      child: Adw.HeaderBar titlebar {
        decoration-layout: bind $_getDecorationLayout() as <string>;

        title-widget: Gtk.Box {
          orientation: vertical;
          valign: center;

          Gtk.Label {
            ellipsize: end;
            wrap: false;
            single-line-mode: true;
            width-chars: 5;
            label: bind template.title;

            styles [
              "title",
            ]
          }

          Gtk.Label {
            ellipsize: middle;
            wrap: false;
            single-line-mode: true;
            width-chars: 5;
            visible: bind template.subtitle-visible;
            label: bind template.subtitle;

            styles [
              "subtitle",
            ]
          }
        }

        [start]
        Button fullscreen_button {
          icon-name: "view-fullscreen-symbolic";
          action-name: "win.fullscreen";
          tooltip-text: _("Toggle Fullscreen");
        }

        [end]
        Button {
          icon-name: "detach-symbolic";
          action-name: "win.open-file";
          tooltip-text: _("Open");
        }
      };
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Stack mainStack {
        visible-child: spinner;

        StackPage loading {
          child: Adw.Spinner spinner {};
        }
      };
    };
  };

  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "f";
      action: "action(win.fullscreen)";
    }

    Shortcut {
      trigger: "F11";
      action: "action(win.fullscreen)";
    }

    Shortcut {
      trigger: "o";
      action: "action(win.open-file)";
    }
  }
}
