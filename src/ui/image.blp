using Gtk 4.0;

template $Gjs_ImageRenderer: Picture {
  content-fit: scale_down;
  halign: center;
  valign: center;

  GestureClick {
    pressed => $_handleClick();
  }

  ShortcutController {
    scope: managed;

    Shortcut {
      trigger: "<Ctrl>c";
      action: "action(image.copy)";
    }
  }
}
